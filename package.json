{
  "name": "archon-efficient-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "archon-harness": "src/cli.ts"
  },
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "bun test",
    "test:e2e:no-model": "bun tests/integration/archon-no-model.ts",
    "doctor": "bun src/cli.ts doctor",
    "smoke": "bun src/cli.ts smoke",
    "benchmark": "bun src/cli.ts benchmark",
    "ui": "bun src/cli.ts ui",
    "install:harness": "bun src/cli.ts install"
  },
  "dependencies": {
    "@agentmemory/agentmemory": "0.9.28",
    "@earendil-works/pi-coding-agent": "0.82.1",
    "@oh-my-pi/hashline": "17.1.6",
    "@oh-my-pi/pi-coding-agent": "17.1.6",
    "@sinclair/typebox": "0.34.41",
    "@slack/bolt": "5.0.0",
    "commander": "14.0.2",
    "gitnexus": "1.6.9",
    "gpt-tokenizer": "3.4.0",
    "pi-hashline-edit-pro": "0.18.0",
    "typebox": "1.1.38",
    "yaml": "2.8.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@types/bun": "1.3.5",
    "typescript": "5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=22.15.0"
  },
  "trustedDependencies": [
    "@ladybugdb/core",
    "gitnexus",
    "tree-sitter"
  ]
}
